# ===== الخادم =====
PORT=8080
# الرابط العام للخادم (https) بدون / في النهاية
PUBLIC_URL=https://api.jifirephone.com
# مفتاح مشترك مع التطبيق (موجود أيضاً داخل الـAPK)
APP_KEY=CjfOL_E-NwQcgHAXoc-R-4nzoJlWFQA6

# ===== Shopify (تطبيق من Dev Dashboard) =====
SHOPIFY_SHOP=tfmwtv-d3.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# اختياري: إذا كان عندك توكن قديم shpat_ ضعه هنا بدل Client ID/Secret
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
# إرسال إيميل تأكيد الطلب من Shopify للزبون (إذا كتب إيميله)
SEND_ORDER_RECEIPT=false
# ربط الطلب بحساب زبون (حسب رقم الهاتف)
UPSERT_CUSTOMER=true
ORDER_TAG=تطبيق جي فاير

# ===== التوصيل =====
# أجرة التوصيل الافتراضية بالدينار (0 = مجاني)
DELIVERY_FEE=0
# أجور خاصة لكل محافظة (اختياري) مثال: بغداد:5000,البصرة:7000
DELIVERY_FEES=
# توصيل مجاني فوق هذا المبلغ (0 = معطّل)
FREE_DELIVERY_OVER=0

# ===== الاستلام من المتجر =====
PICKUP_ENABLED=true
PICKUP_TITLE=استلام من المتجر
PICKUP_ADDRESS=
PICKUP_HOURS=

# ===== طرق الدفع =====
COD_ENABLED=true
AQSATI_ENABLED=false
# رابط موقع أقساطي الحالي (الذي عمله المبرمج). يُفتح للزبون بعد تسجيل الطلب.
# متغيرات متاحة: {order_id} {order_number} {order_name} {total} {phone} {name} {email}
# مثال: https://aqsati.jifirephone.com/pay?order={order_id}
AQSATI_REDIRECT_URL=
# اسم طريقة الدفع كما يتوقعها نظام أقساطي في Shopify (Gateway)
AQSATI_GATEWAY_NAME=Aqsati
AQSATI_NOTE=سيتواصل معك فريق جي فاير لإكمال إجراءات التقسيط عبر كي كارد قبل التوصيل.

# ===== HyperPay (الدفع بالبطاقة) — يتفعّل تلقائياً عند تعبئة المفاتيح =====
# للتجربة: https://eu-test.oppwa.com   للتشغيل الفعلي: https://eu-prod.oppwa.com
HYPERPAY_HOST=https://eu-prod.oppwa.com
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_CURRENCY=IQD
# إذا كانت عملة البوابة غير الدينار: سعر التحويل (مثال للدولار: 0.000763)
HYPERPAY_RATE=1
HYPERPAY_BRANDS=VISA MASTER
# على بيئة التجربة فقط: EXTERNAL
HYPERPAY_TEST_MODE=

# ===== حماية =====
ORDERS_PER_IP_10MIN=6
